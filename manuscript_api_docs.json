{
    "manuscript_submission": {
        "title": "Manuscript Submission API",
        "base_url": "/api/manuscripts",
        "endpoints": [
            {
                "method": "POST",
                "path": "/submit",
                "description": "Submit a new manuscript",
                "headers": {
                    "Content-Type": "multipart/form-data"
                },
                "body": {
                    "journal_id": "Integer (Required)",
                    "manuscript_type": "String (Required)",
                    "paper_title": "String (Required)",
                    "abstract": "String (Required)",
                    "keywords": "String (Required)",
                    "word_count": "Integer (Optional)",
                    "no_of_words_text": "String (Optional)",
                    "page_count": "Integer (Optional)",
                    "table_count": "Integer (Optional)",
                    "figure_count": "Integer (Optional)",
                    "author_first_name": "String (Required)",
                    "author_last_name": "String (Required)",
                    "author_email": "String (Required)",
                    "author_country": "String (Required)",
                    "author_phone": "String (Required)",
                    "author_institution": "String (Required)",
                    "author_department": "String (Optional)",
                    "author_state": "String (Optional)",
                    "author_city": "String (Optional)",
                    "author_address": "String (Required)",
                    "reviewer_first_name": "String (Optional)",
                    "reviewer_last_name": "String (Optional)",
                    "reviewer_email": "String (Optional)",
                    "reviewer_phone": "String (Optional)",
                    "reviewer_country": "String (Optional)",
                    "reviewer_institution": "String (Optional)",
                    "reviewer_designation": "String (Optional)",
                    "reviewer_specialisation": "String (Optional)",
                    "reviewer_department": "String (Optional)",
                    "reviewer_state": "String (Optional)",
                    "reviewer_city": "String (Optional)",
                    "reviewer_address": "String (Optional)",
                    "manuscriptFile": "File (Required, .doc, .docx, .pdf)",
                    "coverLetter": "File (Optional, .doc, .docx, .pdf)"
                },
                "response": {
                    "success": {
                        "message": "Manuscript submitted successfully",
                        "manuscriptId": "UUID"
                    },
                    "error": {
                        "message": "Error message"
                    }
                }
            },
            {
                "method": "GET",
                "path": "/",
                "description": "Get all manuscripts",
                "response": [
                    {
                        "id": 1,
                        "paper_title": "Sample Paper",
                        "status": "Submitted"
                    }
                ]
            },
            {
                "method": "GET",
                "path": "/:id",
                "description": "Get manuscript by ID",
                "response": {
                    "id": 1,
                    "paper_title": "Sample Paper"
                }
            },
            {
                "method": "GET",
                "path": "/author/:authorId",
                "description": "Get manuscripts by Author ID",
                "response": [
                    {
                        "id": 1,
                        "paper_title": "Sample Paper"
                    }
                ]
            }
        ]
    },
    "publication_api": {
        "title": "Manuscript Publication API",
        "base_url": "/api/publications",
        "endpoints": [
            {
                "method": "POST",
                "path": "/",
                "description": "Create a new publication (Admin only)",
                "headers": {
                    "Authorization": "Bearer <token>",
                    "Content-Type": "multipart/form-data"
                },
                "body": {
                    "journal_id": "Integer (Required)",
                    "issue_id": "Integer (Required)",
                    "manuscript_id": "String (Required)",
                    "title": "String (Required)",
                    "author_name": "String (Required)",
                    "doi": "String (Optional)",
                    "pages": "String (Optional)",
                    "author_affiliations": "String (Optional)",
                    "abstract_description": "String (Optional)",
                    "abstract_keywords": "String (Optional)",
                    "pdf_file": "File (Required, .pdf)"
                },
                "response": {
                    "success": true,
                    "message": "Publication created successfully",
                    "data": {
                        "id": 1,
                        "title": "Sample Paper"
                    }
                }
            },
            {
                "method": "GET",
                "path": "/",
                "description": "Get all publications",
                "query_params": {
                    "journal_id": "Integer (Optional)",
                    "issue_id": "Integer (Optional)",
                    "search": "String (Optional)"
                },
                "response": {
                    "success": true,
                    "count": 10,
                    "message": "Publications fetched successfully",
                    "data": [
                        {
                            "id": 1,
                            "manuscript_id": "MS-2024-001",
                            "title": "Sample Paper",
                            "author_name": "Dr. John Doe",
                            "doi": "10.1234/journal.2024.001",
                            "pages": "10-25",
                            "author_affiliations": "University of Science",
                            "abstract_description": "This is a detailed abstract...",
                            "abstract_keywords": "Science, Technology, Innovation",
                            "pdf_file": "uploads/publications/paper.pdf",
                            "journal": {
                                "id": 1,
                                "title": "Journal Name",
                                "print_issn": "1234-5678",
                                "e_issn": "8765-4321",
                                "editors": "Editor Name",
                                "frequency": "Monthly",
                                "indexation": "Indexation Details",
                                "start_year": 2020,
                                "end_year": null,
                                "mission": "Mission Statement",
                                "aims_scope": "Aims and Scope",
                                "areas_covered": [
                                    "Area 1",
                                    "Area 2"
                                ],
                                "image": "image.jpg",
                                "category_id": 1
                            },
                            "issue": {
                                "volume": "Vol 1",
                                "issue_no": "Issue 1",
                                "year": 2024
                            }
                        }
                    ]
                }
            },
            {
                "method": "GET",
                "path": "/:id",
                "description": "Get publication by ID",
                "response": {
                    "success": true,
                    "message": "Publication details fetched successfully",
                    "data": {
                        "id": 1,
                        "manuscript_id": "MS-2024-001",
                        "title": "Sample Paper",
                        "author_name": "Dr. John Doe",
                        "doi": "10.1234/journal.2024.001",
                        "pages": "10-25",
                        "author_affiliations": "University of Science",
                        "abstract_description": "This is a detailed abstract...",
                        "abstract_keywords": "Science, Technology, Innovation",
                        "pdf_file": "uploads/publications/paper.pdf",
                        "journal": {
                            "id": 1,
                            "title": "Journal Name",
                            "print_issn": "1234-5678",
                            "e_issn": "8765-4321",
                            "editors": "Editor Name",
                            "frequency": "Monthly",
                            "indexation": "Indexation Details",
                            "start_year": 2020,
                            "end_year": null,
                            "mission": "Mission Statement",
                            "aims_scope": "Aims and Scope",
                            "areas_covered": [
                                "Area 1",
                                "Area 2"
                            ],
                            "image": "image.jpg",
                            "category_id": 1
                        },
                        "issue": {
                            "volume": "Vol 1",
                            "issue_no": "Issue 1",
                            "year": 2024
                        }
                    }
                }
            }
        ]
    }
}