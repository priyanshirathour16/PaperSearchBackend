{
    "apiTitle": "Manuscript Submission API",
    "version": "2.0.0",
    "description": "Complete API documentation for multi-step manuscript submission system with OTP verification",
    "baseUrl": "http://localhost:5000/api",
    "endpoints": [
        {
            "name": "Send OTP for Email Verification",
            "method": "POST",
            "path": "/otp/send",
            "description": "Send a 6-digit OTP to the author's email for verification. OTP expires in 10 minutes. This is the first step in the submission process.",
            "authentication": "None",
            "requestBody": {
                "contentType": "application/json",
                "schema": {
                    "email": {
                        "type": "string",
                        "required": true,
                        "format": "email",
                        "description": "Author's email address",
                        "example": "author@example.com"
                    },
                    "name": {
                        "type": "string",
                        "required": true,
                        "description": "Author's full name",
                        "example": "John Doe"
                    },
                    "phone": {
                        "type": "string",
                        "required": true,
                        "description": "Author's phone number",
                        "example": "+1234567890"
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "OTP sent successfully",
                    "example": {
                        "success": true,
                        "message": "OTP sent successfully to your email",
                        "expiresIn": "10 minutes"
                    }
                },
                "400": {
                    "description": "Validation error",
                    "example": {
                        "success": false,
                        "errors": [
                            {
                                "msg": "Please provide a valid email address",
                                "param": "email"
                            }
                        ]
                    }
                },
                "500": {
                    "description": "Server error",
                    "example": {
                        "error": "Failed to send OTP. Please try again."
                    }
                }
            }
        },
        {
            "name": "Verify OTP",
            "method": "POST",
            "path": "/otp/verify",
            "description": "Verify the OTP code sent to the author's email. Upon successful verification, an author account is automatically created with a temporary password and credentials are sent via email.",
            "authentication": "None",
            "requestBody": {
                "contentType": "application/json",
                "schema": {
                    "email": {
                        "type": "string",
                        "required": true,
                        "format": "email",
                        "description": "Author's email address",
                        "example": "author@example.com"
                    },
                    "otp": {
                        "type": "string",
                        "required": true,
                        "length": 6,
                        "pattern": "^[0-9]{6}$",
                        "description": "6-digit OTP code",
                        "example": "123456"
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "OTP verified successfully and author account created",
                    "example": {
                        "success": true,
                        "message": "Email verified successfully",
                        "authorCreated": true,
                        "tempPassword": "Password@123"
                    }
                },
                "400": {
                    "description": "Invalid or expired OTP",
                    "example": {
                        "success": false,
                        "message": "Invalid or expired OTP"
                    }
                },
                "500": {
                    "description": "Server error",
                    "example": {
                        "error": "Failed to verify OTP. Please try again."
                    }
                }
            }
        },
        {
            "name": "Submit Manuscript",
            "method": "POST",
            "path": "/manuscripts/submit",
            "description": "Submit a complete manuscript with all details. Supports both guest submission (auto-creates author account) and logged-in author submission.",
            "authentication": "Optional (Bearer token for logged-in authors)",
            "requestBody": {
                "contentType": "multipart/form-data",
                "schema": {
                    "name": {
                        "type": "string",
                        "required": true,
                        "description": "Author's full name (for guest submission)",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "required": true,
                        "format": "email",
                        "description": "Author's email (must be verified via OTP for guest submission)",
                        "example": "author@example.com"
                    },
                    "phone": {
                        "type": "string",
                        "required": true,
                        "description": "Author's phone number",
                        "example": "+1234567890"
                    },
                    "journalId": {
                        "type": "integer",
                        "required": true,
                        "description": "ID of the journal to submit to",
                        "example": 1
                    },
                    "manuscriptType": {
                        "type": "string",
                        "required": true,
                        "enum": [
                            "Research paper",
                            "Case study",
                            "Book review",
                            "Review paper",
                            "Perspective",
                            "Report",
                            "Invited article"
                        ],
                        "description": "Type of manuscript",
                        "example": "Research paper"
                    },
                    "paperTitle": {
                        "type": "string",
                        "required": true,
                        "description": "Title of the manuscript",
                        "example": "Advanced Machine Learning Techniques"
                    },
                    "abstract": {
                        "type": "string",
                        "required": true,
                        "maxWords": 200,
                        "description": "Abstract of the manuscript (max 200 words)",
                        "example": "This paper presents..."
                    },
                    "wordCount": {
                        "type": "integer",
                        "required": false,
                        "description": "Total word count of the manuscript",
                        "example": 5000
                    },
                    "keywords": {
                        "type": "string",
                        "required": false,
                        "description": "Keywords as JSON array or comma-separated string",
                        "example": "[\"machine learning\", \"AI\", \"neural networks\"]"
                    },
                    "authors": {
                        "type": "string",
                        "required": false,
                        "description": "JSON array of co-authors",
                        "example": "[{\"firstName\":\"Jane\",\"lastName\":\"Smith\",\"email\":\"jane@example.com\",\"phone\":\"+1234567890\",\"country\":\"USA\",\"institution\":\"MIT\",\"designation\":\"Professor\",\"department\":\"Computer Science\",\"state\":\"MA\",\"city\":\"Boston\",\"address\":\"123 Main St\",\"isCorrespondingAuthor\":true}]"
                    },
                    "reviewerFirstName": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's first name",
                        "example": "Robert"
                    },
                    "reviewerLastName": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's last name",
                        "example": "Johnson"
                    },
                    "reviewerEmail": {
                        "type": "string",
                        "required": false,
                        "format": "email",
                        "description": "Suggested reviewer's email",
                        "example": "reviewer@university.edu"
                    },
                    "reviewerPhone": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's phone",
                        "example": "+1234567890"
                    },
                    "reviewerCountry": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's country",
                        "example": "USA"
                    },
                    "reviewerInstitution": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's institution",
                        "example": "Harvard University"
                    },
                    "reviewerDesignation": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's designation",
                        "example": "Associate Professor"
                    },
                    "reviewerSpecialisation": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's specialisation",
                        "example": "Machine Learning"
                    },
                    "reviewerDepartment": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's department",
                        "example": "Computer Science"
                    },
                    "reviewerState": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's state",
                        "example": "MA"
                    },
                    "reviewerCity": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's city",
                        "example": "Cambridge"
                    },
                    "reviewerAddress": {
                        "type": "string",
                        "required": false,
                        "description": "Suggested reviewer's address",
                        "example": "456 University Ave"
                    },
                    "checklist": {
                        "type": "string",
                        "required": false,
                        "description": "JSON object with submission checklist consents",
                        "example": "{\"isSoleSubmission\":true,\"isNotPublished\":true,\"isOriginalWork\":true,\"hasDeclaredConflicts\":true,\"hasAcknowledgedSupport\":true,\"hasAcknowledgedFunding\":true,\"followsGuidelines\":true}"
                    },
                    "manuscriptFile": {
                        "type": "file",
                        "required": true,
                        "accept": [
                            ".doc",
                            ".docx",
                            ".pdf"
                        ],
                        "description": "Manuscript file (without author details)",
                        "maxSize": "10MB"
                    },
                    "coverLetter": {
                        "type": "file",
                        "required": false,
                        "accept": [
                            ".doc",
                            ".docx",
                            ".pdf"
                        ],
                        "description": "Cover letter file (optional)",
                        "maxSize": "5MB"
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Manuscript submitted successfully",
                    "example": {
                        "success": true,
                        "manuscriptId": "AMLJ-2025-001",
                        "message": "Congratulations! You have successfully submitted your manuscript. Your manuscript ID is: AMLJ-2025-001. Please check your mailbox for acknowledgement of receipt of manuscript.",
                        "isNewAuthor": true
                    }
                },
                "400": {
                    "description": "Validation error",
                    "example": {
                        "error": "Abstract exceeds maximum word limit of 200 words (current: 250 words)"
                    }
                },
                "404": {
                    "description": "Journal not found",
                    "example": {
                        "error": "Journal not found"
                    }
                },
                "500": {
                    "description": "Server error",
                    "example": {
                        "error": "Failed to submit manuscript"
                    }
                }
            }
        },
        {
            "name": "Get All Manuscripts (Basic)",
            "method": "GET",
            "path": "/manuscripts",
            "description": "Get a list of all manuscripts with basic information",
            "authentication": "Required (Admin/Editor)",
            "responses": {
                "200": {
                    "description": "List of manuscripts",
                    "example": [
                        {
                            "id": 1,
                            "manuscript_id": "AMLJ-2025-001",
                            "createdAt": "2025-12-16T05:30:00.000Z",
                            "status": "Submitted",
                            "journal": {
                                "title": "Advanced Machine Learning Journal"
                            },
                            "submitter_name": "John Doe",
                            "submitter_email": "author@example.com"
                        }
                    ]
                }
            }
        },
        {
            "name": "Get Manuscript Details",
            "method": "GET",
            "path": "/manuscripts/:manuscriptId",
            "description": "Get complete details of a specific manuscript by its public manuscript ID",
            "authentication": "Required",
            "parameters": {
                "manuscriptId": {
                    "type": "string",
                    "required": true,
                    "description": "Public manuscript ID (e.g., AMLJ-2025-001)",
                    "example": "AMLJ-2025-001"
                }
            },
            "responses": {
                "200": {
                    "description": "Manuscript details",
                    "example": {
                        "id": 1,
                        "manuscript_id": "AMLJ-2025-001",
                        "journal_id": 1,
                        "author_id": 1,
                        "paper_title": "Advanced Machine Learning Techniques",
                        "manuscript_type": "Research paper",
                        "word_count": 5000,
                        "no_of_words_text": "Five Thousand words only",
                        "abstract": "This paper presents...",
                        "keywords": "machine learning, AI, neural networks",
                        "manuscript_file_path": "uploads/manuscripts/file.pdf",
                        "cover_letter_path": "uploads/cover-letters/letter.pdf",
                        "status": "Submitted",
                        "createdAt": "2025-12-16T05:30:00.000Z",
                        "journal": {
                            "title": "Advanced Machine Learning Journal",
                            "print_issn": "1234-5678"
                        },
                        "submitter_name": "John Doe",
                        "submitter_email": "author@example.com",
                        "submitter_phone": "+1234567890",
                        "authors": [
                            {
                                "first_name": "Jane",
                                "last_name": "Smith",
                                "email": "jane@example.com",
                                "phone": "+1234567890",
                                "country": "USA",
                                "institution": "MIT",
                                "designation": "Professor",
                                "department": "Computer Science",
                                "is_corresponding_author": true
                            }
                        ],
                        "reviewer_first_name": "Robert",
                        "reviewer_last_name": "Johnson",
                        "reviewer_email": "reviewer@university.edu",
                        "reviewer_institution": "Harvard University",
                        "reviewer_designation": "Associate Professor",
                        "reviewer_specialisation": "Machine Learning"
                    }
                },
                "404": {
                    "description": "Manuscript not found",
                    "example": {
                        "error": "Manuscript not found"
                    }
                }
            }
        },
        {
            "name": "Get Author's Manuscripts",
            "method": "GET",
            "path": "/manuscripts/author/:authorId",
            "description": "Get all manuscripts submitted by a specific author",
            "authentication": "Required",
            "parameters": {
                "authorId": {
                    "type": "integer",
                    "required": true,
                    "description": "Author's database ID",
                    "example": 1
                }
            },
            "responses": {
                "200": {
                    "description": "List of author's manuscripts",
                    "example": [
                        {
                            "id": 1,
                            "manuscript_id": "AMLJ-2025-001",
                            "paper_title": "Advanced Machine Learning Techniques",
                            "manuscript_type": "Research paper",
                            "status": "Submitted",
                            "createdAt": "2025-12-16T05:30:00.000Z",
                            "journal": {
                                "title": "Advanced Machine Learning Journal",
                                "print_issn": "1234-5678"
                            },
                            "authors": [
                                {
                                    "first_name": "Jane",
                                    "last_name": "Smith",
                                    "email": "jane@example.com",
                                    "is_corresponding_author": true
                                }
                            ]
                        }
                    ]
                }
            }
        }
    ],
    "notes": [
        "All file uploads should use multipart/form-data encoding",
        "Manuscript files must be in .doc, .docx, or .pdf format",
        "Abstract is limited to 200 words maximum",
        "OTP expires after 10 minutes",
        "Author account is automatically created during OTP verification with temporary password 'Password@123'",
        "Welcome email with credentials is sent immediately after OTP verification",
        "Manuscript submission requires prior OTP verification - author account must exist",
        "Manuscript ID format: {JOURNAL_INITIALS}-{YEAR}-{SEQUENCE} (e.g., AMLJ-2025-001)",
        "Email notifications are sent for: OTP verification, account creation (with credentials), and submission acknowledgment"
    ]
}