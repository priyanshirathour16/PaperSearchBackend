{
    "publicEndpoints": {
        "submitApplication": {
            "method": "POST",
            "url": "/api/editor-applications",
            "description": "Submit a new editor application. Requires 'file' upload for CV.",
            "contentType": "multipart/form-data",
            "body": {
                "journal": "Integer (Required, Journal ID)",
                "title": "String (Optional, e.g., 'Dr.')",
                "firstName": "String (Required)",
                "lastName": "String (Required)",
                "email": "String (Required, Valid Email)",
                "confirmEmail": "String (Required, Must match email)",
                "password": "String (Required, Min 6 chars)",
                "confirmPassword": "String (Required, Must match password)",
                "qualification": "String (Optional)",
                "specialization": "String (Optional)",
                "institute": "String (Optional)",
                "file": "File (Required, CV/Resume)"
            },
            "response": {
                "success": {
                    "status": 201,
                    "body": {
                        "message": "Editor application submitted successfully",
                        "application": {
                            "id": 1,
                            "journal_id": 19,
                            "firstName": "John",
                            "lastName": "Doe",
                            "email": "john@example.com",
                            "status": "pending",
                            "createdAt": "2024-12-09T12:00:00.000Z"
                        }
                    }
                },
                "error": {
                    "status": 400,
                    "body": {
                        "errors": [
                            {
                                "msg": "Journal is required",
                                "path": "journal",
                                "type": "field"
                            }
                        ]
                    }
                }
            }
        }
    },
    "adminEndpoints": {
        "getAllApplications": {
            "method": "GET",
            "url": "/api/editor-applications",
            "headers": {
                "Authorization": "Bearer <admin_jwt_token>"
            },
            "response": [
                {
                    "id": 1,
                    "journal": "International Journal of Science (Mapped from ID)",
                    "title": "Dr.",
                    "firstName": "John",
                    "lastName": "Doe",
                    "email": "john@example.com",
                    "status": "pending",
                    "createdAt": "2024-12-09T12:00:00.000Z"
                }
            ]
        },
        "getApplicationById": {
            "method": "GET",
            "url": "/api/editor-applications/:id",
            "headers": {
                "Authorization": "Bearer <admin_jwt_token>"
            },
            "response": {
                "id": 1,
                "journal": "International Journal of Science",
                "firstName": "John",
                "lastName": "Doe",
                "cvFile": "uploads/cv-123.pdf"
            }
        },
        "deleteApplication": {
            "method": "DELETE",
            "url": "/api/editor-applications/:id",
            "description": "Soft delete an application.",
            "headers": {
                "Authorization": "Bearer <admin_jwt_token>"
            },
            "response": {
                "message": "Application deleted successfully"
            }
        }
    }
}