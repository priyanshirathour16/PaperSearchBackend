{
    "module": "Journal Issue Management",
    "baseUrl": "/api/journal-issues",
    "description": "API endpoints for managing journal issues under which manuscripts will be published",
    "authentication": "Required - JWT token in Authorization header",
    "authorization": "Admin role required",
    "dataModel": {
        "JournalIssue": {
            "id": {
                "type": "integer",
                "description": "Auto-generated unique identifier",
                "example": 1
            },
            "journal_id": {
                "type": "integer",
                "description": "Foreign key reference to Journal table",
                "required": true,
                "example": 5
            },
            "volume": {
                "type": "string",
                "description": "Volume number/identifier",
                "required": true,
                "minLength": 1,
                "maxLength": 50,
                "example": "10"
            },
            "issue_no": {
                "type": "string",
                "description": "Issue number/identifier",
                "required": true,
                "minLength": 1,
                "maxLength": 50,
                "example": "2"
            },
            "year": {
                "type": "integer",
                "description": "Publication year",
                "required": true,
                "min": 1900,
                "max": 2100,
                "example": 2024
            },
            "createdAt": {
                "type": "datetime",
                "description": "Timestamp when record was created",
                "example": "2024-12-03T11:30:00.000Z"
            },
            "updatedAt": {
                "type": "datetime",
                "description": "Timestamp when record was last updated",
                "example": "2024-12-03T11:30:00.000Z"
            },
            "journal": {
                "type": "object",
                "description": "Associated journal details (included in responses)",
                "properties": {
                    "id": "integer",
                    "title": "string"
                }
            }
        }
    },
    "endpoints": [
        {
            "name": "Create Journal Issue",
            "method": "POST",
            "path": "/",
            "description": "Create a new journal issue",
            "authentication": "Required",
            "authorization": "Admin only",
            "headers": {
                "Authorization": "Bearer <jwt_token>",
                "Content-Type": "application/json"
            },
            "requestBody": {
                "journal_id": 5,
                "volume": "10",
                "issue_no": "2",
                "year": 2024
            },
            "validationRules": {
                "journal_id": "Required, must be valid integer >= 1, journal must exist",
                "volume": "Required, string, 1-50 characters",
                "issue_no": "Required, string, 1-50 characters",
                "year": "Required, integer between 1900-2100"
            },
            "successResponse": {
                "statusCode": 201,
                "body": {
                    "success": true,
                    "message": "Journal issue created successfully",
                    "data": {
                        "id": 1,
                        "journal_id": 5,
                        "volume": "10",
                        "issue_no": "2",
                        "year": 2024,
                        "updatedAt": "2024-12-03T11:30:00.000Z",
                        "createdAt": "2024-12-03T11:30:00.000Z"
                    }
                }
            },
            "errorResponses": [
                {
                    "statusCode": 400,
                    "description": "Validation error",
                    "body": {
                        "success": false,
                        "message": "Validation failed",
                        "errors": [
                            {
                                "field": "journal_id",
                                "message": "Journal ID is required"
                            }
                        ]
                    }
                },
                {
                    "statusCode": 404,
                    "description": "Journal not found",
                    "body": {
                        "success": false,
                        "message": "Journal not found"
                    }
                },
                {
                    "statusCode": 401,
                    "description": "Unauthorized - No token provided",
                    "body": {
                        "success": false,
                        "message": "No token provided"
                    }
                },
                {
                    "statusCode": 403,
                    "description": "Forbidden - Not admin",
                    "body": {
                        "success": false,
                        "message": "Access denied. Admin role required."
                    }
                }
            ]
        },
        {
            "name": "Get All Journal Issues",
            "method": "GET",
            "path": "/",
            "description": "Retrieve all journal issues with associated journal details, ordered by year, volume, and issue number (descending)",
            "authentication": "Required",
            "authorization": "Admin only",
            "headers": {
                "Authorization": "Bearer <jwt_token>"
            },
            "queryParameters": "None",
            "successResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "data": [
                        {
                            "id": 1,
                            "journal_id": 5,
                            "volume": "10",
                            "issue_no": "2",
                            "year": 2024,
                            "createdAt": "2024-12-03T11:30:00.000Z",
                            "updatedAt": "2024-12-03T11:30:00.000Z",
                            "journal": {
                                "id": 5,
                                "title": "International Journal of Computer Science"
                            }
                        },
                        {
                            "id": 2,
                            "journal_id": 3,
                            "volume": "5",
                            "issue_no": "1",
                            "year": 2023,
                            "createdAt": "2024-12-02T10:15:00.000Z",
                            "updatedAt": "2024-12-02T10:15:00.000Z",
                            "journal": {
                                "id": 3,
                                "title": "Journal of Applied Mathematics"
                            }
                        }
                    ]
                }
            },
            "errorResponses": [
                {
                    "statusCode": 401,
                    "description": "Unauthorized",
                    "body": {
                        "success": false,
                        "message": "No token provided"
                    }
                },
                {
                    "statusCode": 403,
                    "description": "Forbidden",
                    "body": {
                        "success": false,
                        "message": "Access denied. Admin role required."
                    }
                }
            ]
        },
        {
            "name": "Get Journal Issue by ID",
            "method": "GET",
            "path": "/:id",
            "description": "Retrieve a specific journal issue by its ID",
            "authentication": "Required",
            "authorization": "Admin only",
            "headers": {
                "Authorization": "Bearer <jwt_token>"
            },
            "pathParameters": {
                "id": {
                    "type": "integer",
                    "description": "Journal issue ID",
                    "example": 1
                }
            },
            "successResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "data": {
                        "id": 1,
                        "journal_id": 5,
                        "volume": "10",
                        "issue_no": "2",
                        "year": 2024,
                        "createdAt": "2024-12-03T11:30:00.000Z",
                        "updatedAt": "2024-12-03T11:30:00.000Z",
                        "journal": {
                            "id": 5,
                            "title": "International Journal of Computer Science"
                        }
                    }
                }
            },
            "errorResponses": [
                {
                    "statusCode": 404,
                    "description": "Journal issue not found",
                    "body": {
                        "success": false,
                        "message": "Journal issue not found"
                    }
                },
                {
                    "statusCode": 401,
                    "description": "Unauthorized",
                    "body": {
                        "success": false,
                        "message": "No token provided"
                    }
                }
            ]
        },
        {
            "name": "Get Issues by Journal",
            "method": "GET",
            "path": "/journal/:journalId",
            "description": "Retrieve all issues for a specific journal",
            "authentication": "Required",
            "authorization": "Admin only",
            "headers": {
                "Authorization": "Bearer <jwt_token>"
            },
            "pathParameters": {
                "journalId": {
                    "type": "integer",
                    "description": "Journal ID",
                    "example": 5
                }
            },
            "successResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "data": [
                        {
                            "id": 1,
                            "journal_id": 5,
                            "volume": "10",
                            "issue_no": "2",
                            "year": 2024,
                            "createdAt": "2024-12-03T11:30:00.000Z",
                            "updatedAt": "2024-12-03T11:30:00.000Z",
                            "journal": {
                                "id": 5,
                                "title": "International Journal of Computer Science"
                            }
                        },
                        {
                            "id": 3,
                            "journal_id": 5,
                            "volume": "10",
                            "issue_no": "1",
                            "year": 2024,
                            "createdAt": "2024-12-01T09:20:00.000Z",
                            "updatedAt": "2024-12-01T09:20:00.000Z",
                            "journal": {
                                "id": 5,
                                "title": "International Journal of Computer Science"
                            }
                        }
                    ]
                }
            },
            "errorResponses": [
                {
                    "statusCode": 404,
                    "description": "Journal not found",
                    "body": {
                        "success": false,
                        "message": "Journal not found"
                    }
                }
            ]
        },
        {
            "name": "Update Journal Issue",
            "method": "PUT",
            "path": "/:id",
            "description": "Update an existing journal issue",
            "authentication": "Required",
            "authorization": "Admin only",
            "headers": {
                "Authorization": "Bearer <jwt_token>",
                "Content-Type": "application/json"
            },
            "pathParameters": {
                "id": {
                    "type": "integer",
                    "description": "Journal issue ID",
                    "example": 1
                }
            },
            "requestBody": {
                "journal_id": 5,
                "volume": "10",
                "issue_no": "3",
                "year": 2024
            },
            "validationRules": {
                "journal_id": "Optional, must be valid integer >= 1, journal must exist if provided",
                "volume": "Optional, string, 1-50 characters",
                "issue_no": "Optional, string, 1-50 characters",
                "year": "Optional, integer between 1900-2100"
            },
            "successResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "message": "Journal issue updated successfully",
                    "data": {
                        "id": 1,
                        "journal_id": 5,
                        "volume": "10",
                        "issue_no": "3",
                        "year": 2024,
                        "createdAt": "2024-12-03T11:30:00.000Z",
                        "updatedAt": "2024-12-03T12:45:00.000Z"
                    }
                }
            },
            "errorResponses": [
                {
                    "statusCode": 404,
                    "description": "Journal issue not found",
                    "body": {
                        "success": false,
                        "message": "Journal issue not found"
                    }
                },
                {
                    "statusCode": 400,
                    "description": "Validation error",
                    "body": {
                        "success": false,
                        "message": "Validation failed",
                        "errors": [
                            {
                                "field": "year",
                                "message": "Year must be between 1900 and 2100"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "Delete Journal Issue",
            "method": "DELETE",
            "path": "/:id",
            "description": "Delete a journal issue",
            "authentication": "Required",
            "authorization": "Admin only",
            "headers": {
                "Authorization": "Bearer <jwt_token>"
            },
            "pathParameters": {
                "id": {
                    "type": "integer",
                    "description": "Journal issue ID",
                    "example": 1
                }
            },
            "successResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "message": "Journal issue deleted successfully"
                }
            },
            "errorResponses": [
                {
                    "statusCode": 404,
                    "description": "Journal issue not found",
                    "body": {
                        "success": false,
                        "message": "Journal issue not found"
                    }
                }
            ]
        }
    ],
    "usageExamples": {
        "createIssue": {
            "description": "Example: Creating a new journal issue",
            "curl": "curl -X POST http://localhost:5000/api/journal-issues \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"journal_id\": 5,\n    \"volume\": \"10\",\n    \"issue_no\": \"2\",\n    \"year\": 2024\n  }'",
            "javascript": "const response = await fetch('http://localhost:5000/api/journal-issues', {\n  method: 'POST',\n  headers: {\n    'Authorization': `Bearer ${token}`,\n    'Content-Type': 'application/json'\n  },\n  body: JSON.stringify({\n    journal_id: 5,\n    volume: '10',\n    issue_no: '2',\n    year: 2024\n  })\n});\nconst data = await response.json();"
        },
        "getAllIssues": {
            "description": "Example: Fetching all journal issues",
            "curl": "curl -X GET http://localhost:5000/api/journal-issues \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\"",
            "javascript": "const response = await fetch('http://localhost:5000/api/journal-issues', {\n  headers: {\n    'Authorization': `Bearer ${token}`\n  }\n});\nconst data = await response.json();"
        },
        "getIssueById": {
            "description": "Example: Fetching a specific journal issue",
            "curl": "curl -X GET http://localhost:5000/api/journal-issues/1 \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\"",
            "javascript": "const response = await fetch('http://localhost:5000/api/journal-issues/1', {\n  headers: {\n    'Authorization': `Bearer ${token}`\n  }\n});\nconst data = await response.json();"
        },
        "updateIssue": {
            "description": "Example: Updating a journal issue",
            "curl": "curl -X PUT http://localhost:5000/api/journal-issues/1 \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"issue_no\": \"3\"\n  }'",
            "javascript": "const response = await fetch('http://localhost:5000/api/journal-issues/1', {\n  method: 'PUT',\n  headers: {\n    'Authorization': `Bearer ${token}`,\n    'Content-Type': 'application/json'\n  },\n  body: JSON.stringify({\n    issue_no: '3'\n  })\n});\nconst data = await response.json();"
        },
        "deleteIssue": {
            "description": "Example: Deleting a journal issue",
            "curl": "curl -X DELETE http://localhost:5000/api/journal-issues/1 \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\"",
            "javascript": "const response = await fetch('http://localhost:5000/api/journal-issues/1', {\n  method: 'DELETE',\n  headers: {\n    'Authorization': `Bearer ${token}`\n  }\n});\nconst data = await response.json();"
        }
    },
    "databaseSchema": {
        "tableName": "journal_issues",
        "columns": [
            {
                "name": "id",
                "type": "INTEGER",
                "primaryKey": true,
                "autoIncrement": true,
                "allowNull": false
            },
            {
                "name": "journal_id",
                "type": "INTEGER",
                "allowNull": false,
                "foreignKey": {
                    "table": "Journals",
                    "column": "id",
                    "onDelete": "CASCADE",
                    "onUpdate": "CASCADE"
                }
            },
            {
                "name": "volume",
                "type": "STRING",
                "allowNull": false
            },
            {
                "name": "issue_no",
                "type": "STRING",
                "allowNull": false
            },
            {
                "name": "year",
                "type": "INTEGER",
                "allowNull": false,
                "validate": {
                    "min": 1900,
                    "max": 2100
                }
            },
            {
                "name": "createdAt",
                "type": "DATETIME",
                "allowNull": false,
                "autoGenerated": true
            },
            {
                "name": "updatedAt",
                "type": "DATETIME",
                "allowNull": false,
                "autoGenerated": true
            }
        ],
        "indexes": [
            {
                "name": "journal_id_index",
                "columns": [
                    "journal_id"
                ]
            }
        ],
        "associations": [
            {
                "type": "belongsTo",
                "model": "Journal",
                "foreignKey": "journal_id",
                "as": "journal"
            }
        ]
    },
    "businessRules": [
        "A journal issue must be associated with an existing journal",
        "Volume and issue numbers are stored as strings to support various numbering schemes (e.g., '1', '1-2', 'Special Issue')",
        "Year must be within the range 1900-2100",
        "Issues are ordered by year (descending), volume (descending), and issue number (descending) by default",
        "Deleting a journal will cascade delete all its associated issues",
        "Only authenticated admin users can manage journal issues"
    ],
    "notes": [
        "All endpoints require JWT authentication via Authorization header",
        "All endpoints require admin role authorization",
        "Timestamps (createdAt, updatedAt) are automatically managed by Sequelize",
        "The journal association is automatically included in all responses",
        "Validation errors return 400 status with detailed error messages",
        "Not found errors return 404 status",
        "Authorization errors return 401 (no token) or 403 (not admin)"
    ]
}