{
    "endpoints": {
        "addImpactFactors": {
            "method": "POST",
            "url": "/api/journal-impact-factors",
            "description": "Add one or more impact factors for a specific journal.",
            "headers": {
                "Authorization": "Bearer <admin_jwt_token>"
            },
            "body": {
                "journal_id": "Integer (Required)",
                "factors": [
                    {
                        "year": "Integer (Required)",
                        "impact_factor": "Decimal (Required)"
                    }
                ]
            },
            "response": {
                "message": "Impact factors added successfully",
                "data": [
                    {
                        "id": 1,
                        "journal_id": 1,
                        "year": 2023,
                        "impact_factor": "2.5",
                        "createdAt": "2024-12-09T14:30:00.000Z"
                    }
                ]
            }
        },
        "getImpactFactors": {
            "method": "GET",
            "url": "/api/journal-impact-factors/:journalId",
            "description": "Get all active impact factors for a journal, ordered by year descending.",
            "response": [
                {
                    "id": 1,
                    "journal_id": 1,
                    "year": 2023,
                    "impact_factor": "2.5"
                }
            ]
        },
        "deleteImpactFactor": {
            "method": "DELETE",
            "url": "/api/journal-impact-factors/:id",
            "description": "Soft delete an impact factor entry.",
            "headers": {
                "Authorization": "Bearer <admin_jwt_token>"
            },
            "response": {
                "message": "Impact Factor deleted successfully"
            }
        }
    }
}